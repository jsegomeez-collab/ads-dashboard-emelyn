# Copia este archivo a .env.local y rellena los valores.

# Windsor.ai — conector que extrae Meta Ads
WINDSOR_API_KEY=
# id de la cuenta publicitaria tal y como lo espera Windsor
WINDSOR_ACCOUNT=facebook__XXXXXXXXXXXXXXX

# Motor de IA — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Opcional: tiempo real directo desde Meta -------------------------------
# Windsor sincroniza con Meta a su propio ritmo y no acepta que se le fuerce.
# Con estas dos variables, el boton "Sincronizar" consulta la Marketing API de
# Meta en directo. Sin ellas el panel funciona igual, via Windsor.
# Token: developers.facebook.com > tu app > Marketing API > ads_read
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXXXXX
# META_API_VERSION=v21.0
